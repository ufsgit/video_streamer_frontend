{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "mobile_user (Chrome - CORS Disabled)",
      "request": "launch",
      "type": "dart",
      "args": [
        "-d",
        "chrome",
        "--web-browser-flag",
        "--disable-web-security",
        "--web-browser-flag",
        "--user-data-dir=C:/temp/chrome_dev_user"
      ]
    },
    {
      "name": "mobile_user (Windows Desktop)",
      "request": "launch",
      "type": "dart",
      "args": [
        "-d",
        "windows"
      ]
    }
  ]
}
